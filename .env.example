# MQTT Broker
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=factory/machines/MACHINE-01/telemetry

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=industrial-iot-token
INFLUXDB_ORG=industrial-iot
INFLUXDB_BUCKET=industrial-iot

# Alert Thresholds
ALERT_TEMP_MAX=85
ALERT_VIBRATION_MAX=7.5
ALERT_POWER_MAX=12000

# Simulator
MACHINE_ID=MACHINE-01
PUBLISH_INTERVAL=5
